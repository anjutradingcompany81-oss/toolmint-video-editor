# Copy to deploy/.env.test and fill in real values. Never commit .env.test —
# it's gitignored (see the root .gitignore entry added alongside this file).
#
# This is a separate credential set from deploy/.env.prod — the test stack
# has its own database and bucket, so reusing prod's secrets here isn't
# necessary, but generate real random values rather than leaving them
# guessable, e.g.: openssl rand -base64 32

# --- Postgres (internal only — never exposed outside the Docker network) ---
POSTGRES_USER=toolmint_test
POSTGRES_PASSWORD=
POSTGRES_DB=toolmint_video_editor_test

# --- MinIO / S3-compatible storage ---
S3_BUCKET=toolmint-media-test
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
JWT_ACCESS_SECRET=
