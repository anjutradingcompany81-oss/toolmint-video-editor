# Copy to deploy/.env.prod and fill in real values. Never commit .env.prod —
# it's gitignored (see the root .gitignore entry added alongside this file).
#
# Generate strong random values for every *_PASSWORD / *_SECRET / *_KEY
# below, e.g.: openssl rand -base64 32

# --- Postgres (internal only — never exposed outside the Docker network) ---
POSTGRES_USER=toolmint
POSTGRES_PASSWORD=
POSTGRES_DB=toolmint_video_editor

# --- MinIO / S3-compatible storage ---
# These double as MinIO's root credentials AND the app's S3 access keys —
# MinIO doesn't distinguish the two for a single-bucket setup like this one.
S3_BUCKET=toolmint-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
JWT_ACCESS_SECRET=

# --- AI Repetitive Voice Remover ---
# Required for speaker diarization only (Whisper transcription needs no
# token). Create a token at https://huggingface.co/settings/tokens, and
# accept the license terms on both https://huggingface.co/pyannote/speaker-diarization-3.1
# and https://huggingface.co/pyannote/segmentation-3.0 with that same
# account first, or the model load fails and diarization silently
# degrades to "speaker unknown" instead. Leave blank to run without
# diarization (repetition detection still works, just without the
# different-speakers protection).
HUGGINGFACE_TOKEN=
