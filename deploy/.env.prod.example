# Copy to deploy/.env.prod and fill in real values. Never commit .env.prod —
# it's gitignored (see the root .gitignore entry added alongside this file).
#
# Generate strong random values for every *_PASSWORD / *_SECRET / *_KEY
# below, e.g.: openssl rand -base64 32

# --- Postgres (internal only — never exposed outside the Docker network) ---
POSTGRES_USER=toolmint
POSTGRES_PASSWORD=
POSTGRES_DB=toolmint_video_editor

# --- MinIO / S3-compatible storage ---
# These double as MinIO's root credentials AND the app's S3 access keys —
# MinIO doesn't distinguish the two for a single-bucket setup like this one.
S3_BUCKET=toolmint-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth ---
JWT_ACCESS_SECRET=
