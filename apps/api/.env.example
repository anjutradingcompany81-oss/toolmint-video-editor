# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
API_PORT=4000
WEB_APP_URL=http://localhost:3000

# --- Database (matches docker-compose.yml defaults) ---
# Host port is 5433, not the Postgres default 5432 — this machine already runs
# another project's Postgres on 5432.
DATABASE_URL="postgresql://toolmint:toolmint@localhost:5433/toolmint_video_editor?schema=public"

# --- Redis / queues ---
# Host port is 6380, not the Redis default 6379 — same reason as above.
REDIS_URL="redis://localhost:6380"

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="toolmint-media"
S3_ACCESS_KEY_ID="toolmint"
S3_SECRET_ACCESS_KEY="toolmint123"
S3_FORCE_PATH_STYLE=true

# --- Auth ---
JWT_ACCESS_SECRET="change-me-in-local-env"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- AI provider adapters (leave blank until a module needs them) ---
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
