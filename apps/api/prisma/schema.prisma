// ToolMint Video Editor — Phase 1 (Foundation) schema.
// Only the entities Auth, Dashboard, Project-creation, and Media-upload need.
// Scene/Track/TimelineItem/VoiceOver/ExportJob/etc. are added when their
// owning module is built (see docs/PRD for the full entity list).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
}

enum MediaAssetKind {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
}

enum MediaAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ExportResolution {
  R720P
  R1080P
  // Canvas shape taken from the first clip's own source dimensions instead
  // of a fixed preset.
  ORIGINAL
}

enum ExportQuality {
  STANDARD
  HIGH
  MAXIMUM
}

enum ExportStatus {
  QUEUED
  PROCESSING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  displayName       String
  emailVerifiedAt   DateTime?
  // Created via "Try as guest" — a real, private account, just not tied to
  // a real email. Flagged so a future cleanup job can expire old ones
  // without touching accounts real users registered.
  isGuest           Boolean   @default(false)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       Membership[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  auditLogs   AuditLog[]

  @@map("workspaces")
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(OWNER)
  createdAt   DateTime       @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Project {
  id            String             @id @default(cuid())
  workspaceId   String
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title         String
  // Normalization target for merging clips of different frame rates — not
  // a user-facing "project format" choice; there's no upfront aspect-ratio
  // picker in this editor, the canvas shape is derived from the clips
  // themselves at export time (see ExportResolution.ORIGINAL).
  fps           Int                @default(30)
  // Storage key, not a URL — presigned into thumbnailUrl at response time
  // (same pattern as MediaAsset.storageKey/previewUrl), since the bucket
  // isn't publicly readable.
  thumbnailKey  String?
  isArchived    Boolean            @default(false)
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  versions      ProjectVersion[]
  mediaAssets   MediaAsset[]
  exportJobs    ExportJob[]

  @@index([workspaceId])
  @@map("projects")
}

model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Timeline composition — see docs/PRD "Timeline JSON specification".
  // Validated against the shared schema in packages/types before it is
  // ever written here; this column is never hand-edited.
  composition Json
  label       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_versions")
}

model MediaAsset {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        MediaAssetKind
  status      MediaAssetStatus  @default(UPLOADING)
  originalName String
  storageKey  String            @unique
  proxyKey    String?
  mimeType    String
  byteSize    Int
  durationMs  Int?
  width       Int?
  height      Int?
  // Probed at upload time — lets the merge pipeline generate a silent audio
  // segment for sources with no audio stream instead of erroring out (the
  // concat filter needs a uniform stream count across every segment).
  hasAudio    Boolean           @default(true)
  // Flat array of [min0, max0, min1, max1, ...] floats in -1..1, fixed at
  // 200 buckets regardless of clip length — the timeline stretches this to
  // whatever pixel width the clip occupies. Null for images/documents, or
  // if the file has no audio track (e.g. a silent video).
  waveformPeaks Json?
  checksum    String?
  uploadedById String
  createdAt   DateTime          @default(now())

  @@index([projectId])
  @@map("media_assets")
}

model ExportJob {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolution        ExportResolution
  quality           ExportQuality    @default(STANDARD)
  // User-chosen download filename (sanitized before use) — defaults to the
  // project title if left blank, never used to build a shell command or
  // filesystem path directly.
  outputFileName    String?
  status            ExportStatus     @default(QUEUED)
  progress          Int              @default(0)
  // Set only when a user clicks Cancel — the worker polls this between
  // clip stages and exits cleanly instead of continuing to burn CPU on a
  // render nobody wants anymore.
  cancelRequested   Boolean          @default(false)
  errorMessage      String?
  outputStorageKey  String?
  outputByteSize    Int?
  requestedById     String
  createdAt         DateTime         @default(now())
  completedAt       DateTime?

  @@index([projectId, createdAt])
  @@map("export_jobs")
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
