// ToolMint Video Editor — Phase 1 (Foundation) schema.
// Only the entities Auth, Dashboard, Project-creation, and Media-upload need.
// Scene/Track/TimelineItem/VoiceOver/ExportJob/etc. are added when their
// owning module is built (see docs/PRD for the full entity list).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
}

enum MediaAssetKind {
  VIDEO
  IMAGE
  AUDIO
  DOCUMENT
}

enum MediaAssetStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum ExportResolution {
  R720P
  R1080P
  // Canvas shape taken from the first clip's own source dimensions instead
  // of a fixed preset.
  ORIGINAL
}

enum ExportQuality {
  STANDARD
  HIGH
  MAXIMUM
}

enum ExportStatus {
  QUEUED
  PROCESSING
  UPLOADING
  COMPLETED
  FAILED
  CANCELLED
}

enum VoiceScanScope {
  CLIP
  TIMELINE
}

enum VoiceScanStatus {
  QUEUED
  EXTRACTING_AUDIO
  DETECTING_SPEECH
  TRANSCRIBING
  DIARIZING
  COMPARING
  PREPARING_SUGGESTIONS
  COMPLETED
  FAILED
  CANCELLED
  // Set when the user pauses mid-scan — distinct from CANCELLED so the
  // job's checkpoint (completed chunks) stays around for a resume instead
  // of being treated as abandoned.
  PAUSED
}

enum VoiceOverStatus {
  QUEUED
  SYNTHESIZING
  MIXING
  COMPLETED
  FAILED
  CANCELLED
}

enum SensitivityPreset {
  LOW
  BALANCED
  HIGH
  CUSTOM
}

enum RepetitionKind {
  WORD
  PHRASE
  SENTENCE
  CLIP_OVERLAP
  SCENE_JOIN
  RENDER_DUPLICATE
}

enum ConfidenceBucket {
  HIGH
  MEDIUM
  LOW
}

enum CorrectionMode {
  AUDIO_ONLY
  AUDIO_VIDEO_TRIM
}

enum RepetitionReviewStatus {
  PENDING
  APPLIED
  DISMISSED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  displayName       String
  emailVerifiedAt   DateTime?
  // Created via "Try as guest" — a real, private account, just not tied to
  // a real email. Flagged so a future cleanup job can expire old ones
  // without touching accounts real users registered.
  isGuest           Boolean   @default(false)
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       Membership[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  projects    Project[]
  auditLogs   AuditLog[]

  @@map("workspaces")
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        MembershipRole @default(OWNER)
  createdAt   DateTime       @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Project {
  id            String             @id @default(cuid())
  workspaceId   String
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title         String
  // Normalization target for merging clips of different frame rates — not
  // a user-facing "project format" choice; there's no upfront aspect-ratio
  // picker in this editor, the canvas shape is derived from the clips
  // themselves at export time (see ExportResolution.ORIGINAL).
  fps           Int                @default(30)
  // Storage key, not a URL — presigned into thumbnailUrl at response time
  // (same pattern as MediaAsset.storageKey/previewUrl), since the bucket
  // isn't publicly readable.
  thumbnailKey  String?
  isArchived    Boolean            @default(false)
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  versions      ProjectVersion[]
  mediaAssets   MediaAsset[]
  exportJobs    ExportJob[]
  voiceScanJobs VoiceScanJob[]
  voiceOverJobs VoiceOverJob[]
  voiceOverScript VoiceOverScript?

  @@index([workspaceId])
  @@map("projects")
}

model ProjectVersion {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Timeline composition — see docs/PRD "Timeline JSON specification".
  // Validated against the shared schema in packages/types before it is
  // ever written here; this column is never hand-edited.
  composition Json
  label       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("project_versions")
}

model MediaAsset {
  id          String            @id @default(cuid())
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        MediaAssetKind
  status      MediaAssetStatus  @default(UPLOADING)
  originalName String
  storageKey  String            @unique
  proxyKey    String?
  mimeType    String
  byteSize    Int
  durationMs  Int?
  width       Int?
  height      Int?
  // Probed at upload time — lets the merge pipeline generate a silent audio
  // segment for sources with no audio stream instead of erroring out (the
  // concat filter needs a uniform stream count across every segment).
  hasAudio    Boolean           @default(true)
  // Flat array of [min0, max0, min1, max1, ...] floats in -1..1, fixed at
  // 200 buckets regardless of clip length — the timeline stretches this to
  // whatever pixel width the clip occupies. Null for images/documents, or
  // if the file has no audio track (e.g. a silent video).
  waveformPeaks Json?
  // Cached AI voice-analysis output for this source file, keyed by nothing
  // but the asset itself — since the source is immutable (non-destructive
  // editing), a transcript/fingerprint computed once is valid forever, so
  // re-scanning a project that reuses the same clip never re-transcribes
  // it. Shape: { language, chunks: [{ startMs, endMs, text, mfcc: number[] }] }
  // (see apps/api/src/voice/audio-analysis/transcript-cache.util.ts).
  transcriptCache Json?
  // User-edited overrides for individual transcript lines, keyed by the
  // line's *source-local* chunk start ms (as a string, since JSON object
  // keys are always strings) — e.g. {"22300": "corrected text"}. Applied
  // on top of transcriptCache.chunks when building the transcript view
  // (voice-scan.service.ts#transcript); never mutates transcriptCache
  // itself, so a later re-scan's fresh transcription doesn't silently
  // discard a human correction, and an edit survives independently of
  // ANALYSIS_VERSION cache invalidation.
  transcriptEdits Json?
  checksum    String?
  uploadedById String
  createdAt   DateTime          @default(now())

  repetitionResults RepetitionResult[]

  @@index([projectId])
  @@map("media_assets")
}

model ExportJob {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resolution        ExportResolution
  quality           ExportQuality    @default(STANDARD)
  // User-chosen download filename (sanitized before use) — defaults to the
  // project title if left blank, never used to build a shell command or
  // filesystem path directly.
  outputFileName    String?
  status            ExportStatus     @default(QUEUED)
  progress          Int              @default(0)
  // Set only when a user clicks Cancel — the worker polls this between
  // clip stages and exits cleanly instead of continuing to burn CPU on a
  // render nobody wants anymore.
  cancelRequested   Boolean          @default(false)
  errorMessage      String?
  outputStorageKey  String?
  outputByteSize    Int?
  requestedById     String
  createdAt         DateTime         @default(now())
  completedAt       DateTime?

  @@index([projectId, createdAt])
  @@map("export_jobs")
}

model VoiceScanJob {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope              VoiceScanScope
  // Only set for scope=CLIP — which single clip (on which track) to scan.
  // Both null for scope=TIMELINE (every video/audio clip on the project's
  // latest saved version at scan time).
  trackId            String?
  clipId             String?
  status             VoiceScanStatus   @default(QUEUED)
  // Human-readable current stage ("Extracting audio", "Transcribing
  // dialogue", ...) — the UI shows this directly rather than mapping
  // `status` through its own copy, so adding a stage never means touching
  // frontend strings in two places.
  stageLabel         String?
  progress           Int               @default(0)
  sensitivityPreset  SensitivityPreset @default(BALANCED)
  // Only meaningful when sensitivityPreset=CUSTOM — see
  // voice/audio-analysis/sensitivity.ts for the shape and defaults.
  customThresholds   Json?
  cancelRequested    Boolean           @default(false)
  pauseRequested     Boolean           @default(false)
  // { completedAssetIds: string[], completedChunks: { assetId, chunkIndex }[] }
  // — lets a resumed scan skip audio that was already transcribed/compared
  // rather than starting over from zero.
  checkpoint         Json?
  errorMessage       String?
  requestedById      String
  createdAt          DateTime          @default(now())
  completedAt        DateTime?

  results            RepetitionResult[]

  @@index([projectId, createdAt])
  @@map("voice_scan_jobs")
}

model RepetitionResult {
  id                    String                 @id @default(cuid())
  voiceScanJobId        String
  voiceScanJob          VoiceScanJob           @relation(fields: [voiceScanJobId], references: [id], onDelete: Cascade)
  // The clip/track this repetition was found on, at scan time — used to
  // locate it on the timeline (jump playhead, draw the marker) and to
  // apply a correction. If the clip has since been deleted/moved off that
  // track, applying the correction is rejected with a clear error rather
  // than silently editing the wrong thing.
  trackId               String
  clipId                String
  mediaAssetId           String
  mediaAsset            MediaAsset             @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  kind                  RepetitionKind
  // Timeline-absolute ms, matching the composition's own coordinate space
  // at scan time. Only safe for display//seeking — see the source-relative
  // pair below for anything that has to survive an edit.
  originalStartMs       Int
  originalEndMs         Int
  repeatedStartMs       Int
  repeatedEndMs         Int
  // The same two ranges expressed as offsets into the SOURCE media file.
  // Timeline coordinates and clipId both change the moment the user cuts or
  // splits (removeRangeOnTrack/splitClip mint fresh clip ids and shift every
  // later clip), which orphaned every result from a scan taken before an
  // edit — "That clip no longer exists on the timeline". Source offsets are
  // immutable for a given asset, so a correction can still be located after
  // arbitrary trimming, splitting, moving or reordering. Nullable because
  // rows written before this field existed have no value for it.
  sourceOriginalStartMs Int?
  sourceOriginalEndMs   Int?
  sourceRepeatedStartMs Int?
  sourceRepeatedEndMs   Int?
  originalText          String
  repeatedText          String
  speakerLabel          String?
  transcriptSimilarity  Float
  audioSimilarity       Float
  timingGapMs           Int
  confidenceScore       Float
  confidenceBucket      ConfidenceBucket
  suggestedMode         CorrectionMode
  status                RepetitionReviewStatus @default(PENDING)
  appliedMode           CorrectionMode?
  createdAt             DateTime               @default(now())

  @@index([voiceScanJobId])
  @@index([mediaAssetId])
  @@map("repetition_results")
}

model AuditLog {
  id          String    @id @default(cuid())
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// The working draft of a voice-over script - one per project, edited in
// place as the user rewrites dialogue. Kept OUT of the timeline JSON
// (where subtitles live) on purpose: the timeline is rewritten by the
// editor's autosave on every clip drag, and carrying a full rewritten
// script through those writes would mean re-sending kilobytes of prose
// for an operation that has nothing to do with it. The script also isn't
// a render input - the generated audio asset is.
model VoiceOverScript {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Which TTS provider the user last chose, so reopening the panel
  // restores their selection rather than silently resetting to the
  // default - which may not be the one they actually have a key for.
  providerId String?
  // VoiceOverLine[] - { id, startMs, text, voiceId, speakerLabel }.
  // startMs is a TIMELINE position, so a line stays where the user put it
  // regardless of which clip happens to sit there.
  lines      Json     @default("[]")
  updatedAt  DateTime @updatedAt

  @@map("voice_over_scripts")
}

model VoiceOverJob {
  id                 String          @id @default(cuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status             VoiceOverStatus @default(QUEUED)
  stageLabel         String?
  progress           Int             @default(0)
  providerId         String
  // A snapshot of the script as it was when Generate was pressed - NOT a
  // pointer to VoiceOverScript. The user stays free to keep editing the
  // draft while a job runs, and a finished job has to remain an honest
  // record of what was actually spoken into the file it produced.
  lines              Json
  // Per-line measured output: { lineId, durationMs, overlapsNextByMs }.
  // Synthesis length isn't knowable in advance (it depends on the words),
  // so this is how the UI can tell the user that a rewritten line now
  // runs past the start of the line after it.
  lineTimings        Json?
  // The mixed voice-over track, registered as an ordinary project
  // MediaAsset so it reaches the timeline through exactly the same path
  // as an uploaded audio file - no special-case clip kind, and no
  // separate preview or export handling.
  resultMediaAssetId String?
  cancelRequested    Boolean         @default(false)
  errorMessage       String?
  requestedById      String
  createdAt          DateTime        @default(now())
  completedAt        DateTime?

  @@index([projectId, createdAt])
  @@map("voice_over_jobs")
}
